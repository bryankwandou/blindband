node_modules/
dist/
.env

# Generated by a run. `records.json` is deliberately NOT here: it is the sample
# input, and a clone that cannot run `npm run submit` without asking us for a
# data file is not reproducible by anyone but us.
data/round.json
data/anchor.json
data/receipts.json
data/verification.json

# Belongs to whoever deployed it — tenant DID, contract ids, map names. A
# committed state file makes `npm run deploy` skip registration on someone
# else's tenant and scope their maps to contract ids they do not own.
state.json
