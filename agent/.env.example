# Devnet ed25519 seed (64 hex chars) used to sign round anchors.
# Devnet only. Use a keypair file or a KMS handle for anything else.
SOLANA_SEED_HEX=
SOLANA_RPC_URL=https://api.devnet.solana.com

# T3N credentials. Claim at https://go.terminal3.io/adk-community
# The tenant registers the contract and owns the KV maps.
T3N_API_KEY=
# The agent runs rounds. It needs its own key and its own credits:
# reusing the tenant key fails with InsufficientCreditError.
T3N_AGENT_API_KEY=
T3N_NODE_URL=
